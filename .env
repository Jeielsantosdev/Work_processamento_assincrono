# Configurações da Aplicação
APP_NAME="Sistema de Auditoria Distribuída"
APP_VERSION="1.0.0"
APP_ENV="development"
APP_PORT=":8080"

# Configurações de Banco de Dados
DB_DRIVER="sqlite3"
DB_CONNECTION_STRING="./transactions.db"
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_CONN_LIFETIME=5

# Configurações JWT
JWT_SECRET_KEY="dev-secret-key-change-in-production"
JWT_EXPIRES_IN=24

# Configurações de Fila
QUEUE_TYPE="inmemory"
QUEUE_CONNECTION_STRING="amqp://guest:guest@localhost:5672/"
QUEUE_NAME="transactions"
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF_SECONDS=60

# Configurações de Blockchain
BLOCKCHAIN_TYPE="simple"
BLOCKCHAIN_CONNECTION_URL=""
BLOCKCHAIN_PRIVATE_KEY=""
BLOCKCHAIN_CONTRACT_ADDRESS=""

# Configurações de Logger
LOG_LEVEL="debug"
